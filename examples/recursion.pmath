% Recursive mathematical definitions
\operatorname{fact}(n) :=
\begin{cases}
1 & n = 0 \\
n \cdot \operatorname{fact}(n-1) & n > 0
\end{cases}

\operatorname{fib}(n) :=
\begin{cases}
0 & n = 0 \\
1 & n = 1 \\
\operatorname{fib}(n-1) + \operatorname{fib}(n-2) & n > 1
\end{cases}

\print{\operatorname{fact}(6)}
\print{\operatorname{fib}(10)}
